# Production: set a long random secret and a real HTTPS URL. Never commit secrets.
ORYVETA_BASE_URL=http://127.0.0.1:8000
ORYVETA_DATABASE_PATH=.oryveta/oryveta.db
ORYVETA_COOKIE_SECURE=false
ORYVETA_GITHUB_CLIENT_ID=
ORYVETA_GITHUB_CLIENT_SECRET=
# Local-only demo: disabled by default and never valid with production HTTPS.
ORYVETA_LOCAL_DEMO=true
ORYVETA_WORKSPACE_ROOT=.oryveta/workspaces
# Optional local open-weight inference (disabled by default; no paid API fallback).
ORYVETA_OLLAMA_URL=http://127.0.0.1:11434
ORYVETA_OLLAMA_MODEL=
# Example: qwen2.5-coder:1.5b (run ollama pull before enabling)
